<#@ template hostSpecific="true" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.Data" #>
<#@ assembly name="Microsoft.EntityFrameworkCore" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Design" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Relational" #>
<#@ assembly name="Microsoft.Extensions.DependencyInjection.Abstractions" #>
<#@ assembly name="..\Reference\humanizer.core\3.0.1\lib\net8.0\Humanizer.dll" #>
<#@ parameter name="EntityType" type="Microsoft.EntityFrameworkCore.Metadata.IEntityType" #>
<#@ parameter name="Options" type="Microsoft.EntityFrameworkCore.Scaffolding.ModelCodeGenerationOptions" #>
<#@ parameter name="NamespaceHint" type="System.String" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.ComponentModel.DataAnnotations" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="Microsoft.EntityFrameworkCore" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Design" #>
<#@ import namespace="Microsoft.Extensions.DependencyInjection" #>
<#@ import namespace="Humanizer" #>
<#
    if (EntityType == null)
    {
        return "";
    }
    
    if (EntityType.IsSimpleManyToManyJoinEntityType())
    {
        // Don't scaffold these
        return "";
    }

    var services = (IServiceProvider)Host;
    var annotationCodeGenerator = services.GetRequiredService<IAnnotationCodeGenerator>();
    var code = services.GetRequiredService<ICSharpHelper>();

    var usings = new List<string>();
/*
    {
        "System",
        "System.Collections.Generic",
        "System.Collections.ObjectModel",
        "System.ComponentModel",
        "System.Runtime.CompilerServices"
    };

    if (Options.UseDataAnnotations)
    {
        usings.Add("System.ComponentModel.DataAnnotations");
        usings.Add("System.ComponentModel.DataAnnotations.Schema");
        usings.Add("Microsoft.EntityFrameworkCore");
    }
*/

    if (!string.IsNullOrEmpty(NamespaceHint))
    {
#>
namespace <#= NamespaceHint #>;

<#
    }

    var entityComment = EntityType.GetComment();
    if (!string.IsNullOrEmpty(entityComment))
    {
#>
/// <summary>
/// <#= code.XmlComment(entityComment) #>
/// </summary>
<#
    }

    if (Options != null && Options.UseDataAnnotations)
    {
        var dataAnnotations = EntityType.GetDataAnnotations(annotationCodeGenerator);
        if (dataAnnotations != null)
        {
            foreach (var dataAnnotation in dataAnnotations)
            {
                if (dataAnnotation != null)
                {
#>
<#= code.Fragment(dataAnnotation) #>
<#
                }
            }
        }
    }
    
    string tableName = "";
    string prularizedTableName = "";
//    tableName = EntityType.Name;

///****************************************************************
    tableName = EntityType.GetTableName();
    if (string.IsNullOrEmpty(tableName))
    {
        tableName = EntityType.Name;
    }

    prularizedTableName = tableName.Pluralize();

//****************************************************************/
#>
public partial class <#= tableName #>
{
<#
    string columnName = "";
    string targetTableName = "";
    string prularizedTargetTableName = "";
    var firstProperty = true;
    var properties = EntityType.GetProperties();
    if (properties != null)
    {
        foreach (var property in properties.OrderBy(p => p.GetColumnOrder() ?? -1))
        {
            if (property == null) continue;
            
            columnName = "";
            targetTableName = "";
            prularizedTargetTableName = "";

            if (!firstProperty)
            {
                WriteLine("");
            }

            var propertyComment = property.GetComment();
            if (!string.IsNullOrEmpty(propertyComment))
            {
#>
    /// <summary>
    /// <#= code.XmlComment(propertyComment, indent: 1) #>
    /// </summary>
<#
            }

            if (Options != null && Options.UseDataAnnotations)
            {
                var dataAnnotations = property.GetDataAnnotations(annotationCodeGenerator);
                if (dataAnnotations != null)
                {
                    var filteredAnnotations = dataAnnotations
                        .Where(a => a != null && !(a.Type == typeof(RequiredAttribute) && Options.UseNullableReferenceTypes && !property.ClrType.IsValueType));
                    foreach (var dataAnnotation in filteredAnnotations)
                    {
#>
    <#= code.Fragment(dataAnnotation) #>
<#
                    }
                }
            }

            var requiredUsings = code.GetRequiredUsings(property.ClrType);
            if (requiredUsings != null)
            {
                usings.AddRange(requiredUsings);
            }
            
            var needsNullable = Options != null && Options.UseNullableReferenceTypes && property.IsNullable && !property.ClrType.IsValueType;
            var needsInitializer = Options != null && Options.UseNullableReferenceTypes && !property.IsNullable && !property.ClrType.IsValueType;

//            columnName = property.Name;
            
///****************************************************************
            columnName = property.GetColumnName();
            if (string.IsNullOrEmpty(columnName))
            {
                columnName = property.Name;
            }
//****************************************************************/
#>
    public <#= code.Reference(property.ClrType) #><#= needsNullable ? "?" : "" #> <#= columnName #> { get; set; }
<#
            firstProperty = false;
        }
    }

    var navigations = EntityType.GetNavigations();
    if (navigations != null)
    {
        foreach (var navigation in navigations)
        {
            if (navigation == null) continue;
            
            WriteLine("");
            
//            targetTableName = navigation.TargetEntityType.Name;
//            prularizedTargetTableName = targetTableName;
            
///****************************************************************
            targetTableName = navigation.TargetEntityType.GetTableName();
            if (string.IsNullOrEmpty(targetTableName))
            {
                targetTableName = navigation.TargetEntityType.Name;
            }

            prularizedTargetTableName = targetTableName.Pluralize();
//****************************************************************/
            

            if (Options != null && Options.UseDataAnnotations)
            {
                var dataAnnotations = navigation.GetDataAnnotations(annotationCodeGenerator);
                if (dataAnnotations != null)
                {
                    foreach (var dataAnnotation in dataAnnotations)
                    {
                        if (dataAnnotation != null)
                        {
                            if (code.Fragment(dataAnnotation).StartsWith("[InverseProperty"))
                            {
                                if (navigation.IsCollection)
                                {
//    [InverseProperty(" tableName ")]
                                }
                                else
                                {#>
    [InverseProperty("<#= prularizedTableName #>")]
<#
                                }
                            }
                            else
                            {#>
    <#= code.Fragment(dataAnnotation) #>
<#
                            }
                        }
                    }
                }
            }

            if (navigation.IsCollection)
            {
#>
    public virtual ObservableCollection<<#= targetTableName #>> <#= prularizedTargetTableName #> { get; set; } = new ObservableCollection<<#= targetTableName #>>();
<#
            }
            else
            {
                var needsNullable = Options != null && Options.UseNullableReferenceTypes && !(navigation.ForeignKey.IsRequired && navigation.IsOnDependent);
                var needsInitializer = Options != null && Options.UseNullableReferenceTypes && navigation.ForeignKey.IsRequired && navigation.IsOnDependent;
#>
    public virtual <#= targetTableName #><#= needsNullable ? "?" : "" #> <#= targetTableName #> { get; set; }
<#
            }
        }
    }

    var skipNavigations = EntityType.GetSkipNavigations();
    if (skipNavigations != null)
    {
        foreach (var skipNavigation in skipNavigations)
        {
            if (skipNavigation == null) continue;
            
            WriteLine("");

//            targetTableName = skipNavigation.TargetEntityType.Name;
//            prularizedTargetTableName = targetTableName;

///****************************************************************
            targetTableName = skipNavigation.TargetEntityType.GetTableName();
            if (string.IsNullOrEmpty(targetTableName))
            {
                targetTableName = skipNavigation.TargetEntityType.Name;
            }

            prularizedTargetTableName = targetTableName.Pluralize();
//****************************************************************/

            if (Options != null && Options.UseDataAnnotations)
            {
                var dataAnnotations = skipNavigation.GetDataAnnotations(annotationCodeGenerator);
                if (dataAnnotations != null)
                {
                    foreach (var dataAnnotation in dataAnnotations)
                    {
                        if (dataAnnotation != null)
                        {
#>
    <#= code.Fragment(dataAnnotation) #>
<#
                        }
                    }
                }
            }
#>
    public virtual ObservableCollection<<#= targetTableName #>> <#= prularizedTargetTableName #> { get; set; } = new ObservableCollection<<#= targetTableName #>>();
<#
        }
    }
#>
}
<#
    var previousOutput = GenerationEnvironment;
    GenerationEnvironment = new StringBuilder();

    var distinctUsings = usings.Where(u => !string.IsNullOrEmpty(u)).Distinct().OrderBy(x => x, new NamespaceComparer());
    foreach (var ns in distinctUsings)
    {
#>
using <#= ns #>;
<#
    }

    WriteLine("");

    GenerationEnvironment.Append(previousOutput);
#>