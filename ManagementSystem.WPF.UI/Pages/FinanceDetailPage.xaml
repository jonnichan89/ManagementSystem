<Page x:Class="ManagementSystem.WPF.UI.Pages.FinanceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:commonOM="clr-namespace:ManagementSystem.Common.OtherModels;assembly=ManagementSystem.Common"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:h="clr-namespace:ManagementSystem.WPF.UI.Helpers"
      xmlns:C="clr-namespace:ManagementSystem.WPF.UI.Controls"
      xmlns:conv="clr-namespace:ManagementSystem.WPF.UI.Converters"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:vm="clr-namespace:ManagementSystem.WPF.UI.ViewModels"
      xmlns:data="clr-namespace:ManagementSystem.WPF.UI.Data.DBModels;assembly=ManagementSystem.WPF.UI.Data"
      xmlns:data0="clr-namespace:ManagementSystem.WPF.UI.Data;assembly=ManagementSystem.WPF.UI.Data"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:FinanceDetailPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="{Binding VM.Title, Mode=OneTime}"
      Margin="10"
      Width="1500">
    <Page.Resources>
        <h:BindingProxy x:Key="Page1"
                        Data="{Binding}" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <!--<ScrollViewer CanContentScroll="True"
                  HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Visible">-->
    <Grid x:Name="MainGrid"
          Width="1400">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderThickness="1"
                BorderBrush="Gray"
                CornerRadius="10"
                HorizontalAlignment="Left"
                Padding="10"
                Width="320">
            <StackPanel x:Name="InputContainer">
                <TextBlock Text="{resx:Localization propFinanceCode}"
                           Margin="0,5,0,5" />
                <ui:TextBox Text="{Binding VM.Data.FinanceCode}"
                            IsReadOnly="True"
                            HorizontalContentAlignment="Stretch" />

                <TextBlock Text="{resx:Localization propFinanceDate}"
                           Margin="0,5,0,5" />
                <WrapPanel>
                    <ui:TextBox Text="{Binding VM.Data.FinanceDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='dd MMM yyyy'}"
                                IsReadOnly="True"
                                Margin="0,0,5,0" />

                    <ui:CalendarDatePicker Date="{Binding VM.Data.FinanceDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsEnabled="{Binding VM.CanEditFinanceDate}" />

                </WrapPanel>

                <TextBlock Text="{resx:Localization propFinanceType}" />
                <WrapPanel>
                    <StackPanel>
                        <RadioButton Content="{resx:Localization mwPurchase}"
                                     GroupName="ModuleTypeMenu"
                                     IsChecked="{Binding VM.Data.RTMenuPurchase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="{resx:Localization mwSales}"
                                     GroupName="ModuleTypeMenu"
                                     IsChecked="{Binding VM.Data.RTMenuSales, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="{resx:Localization rtOther}"
                                     GroupName="ModuleTypeMenu"
                                     IsChecked="{Binding VM.Data.RTOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <RadioButton Content="{resx:Localization propFinanceTypeAPDN}"
                                     GroupName="ModuleTypeFinanceType"
                                     IsChecked="{Binding VM.Data.FTAPDebitNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="{resx:Localization propFinanceTypeAPCN}"
                                     GroupName="ModuleTypeFinanceType"
                                     IsChecked="{Binding VM.Data.FTAPCreditNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="{resx:Localization propFinanceTypeARDN}"
                                     GroupName="ModuleTypeFinanceType"
                                     IsChecked="{Binding VM.Data.FTARDebitNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Content="{resx:Localization propFinanceTypeARCN}"
                                     GroupName="ModuleTypeFinanceType"
                                     IsChecked="{Binding VM.Data.FTARCreditNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{resx:Localization propReferenceCode}" />
                <ComboBox x:Name="PSOrderComboBox"
                          ItemsSource="{Binding VM.CBVMPSOrder.FilteredListItem}"
                          SelectedItem="{Binding VM.CBVMPSOrder.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsTextSearchEnabled="False"
                          IsTextSearchCaseSensitive="False"
                          IsEditable="True"
                          StaysOpenOnEdit="True"
                          IsReadOnly="False"
                          ScrollViewer.CanContentScroll="True"
                          TextSearch.TextPath="PSCode"
                          SelectedIndex="{Binding VM.CBVMPSOrder.SelectedIndex, Mode=OneWay}"
                          Visibility="{Binding Data.VM.Data.IsRTPS, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="commonOM:SearchOptionResultPSOrder">
                            <StackPanel Width="300">
                                <ui:TextBlock Text="{Binding PSCode}" />
                                <ui:TextBlock Text="{Binding SupplierCode}"
                                              Margin="10,0,0,0" />
                                <ui:TextBlock Text="{Binding SupplierName}"
                                              Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:TextBox Text="{Binding VM.Data.ReferenceCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding Data.VM.Data.IsRTOther, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{resx:Localization propSupplierCode}" />
                <ui:TextBox Text="{Binding VM.Data.SupplierCode}"
                            IsReadOnly="True" />

                <TextBlock Text="{resx:Localization propSupplierName}" />
                <ComboBox x:Name="SupplierComboBox"
                          ItemsSource="{Binding VM.SupplierCBVM.FilteredViewSupplier}"
                          SelectedItem="{Binding VM.SupplierCBVM.SelectedSupplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsTextSearchEnabled="False"
                          IsTextSearchCaseSensitive="False"
                          IsEditable="True"
                          StaysOpenOnEdit="True"
                          IsReadOnly="False"
                          ScrollViewer.CanContentScroll="True"
                          TextSearch.TextPath="SupplierName"
                          SelectedIndex="{Binding VM.SupplierCBVM.SupplierSelectedIndex, Mode=OneWay}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="data:MstSupplier">
                            <StackPanel Width="300">
                                <WrapPanel>
                                    <ui:TextBlock Text="{Binding Askterisk}"
                                                  Width="10" />
                                    <ui:TextBlock Text="{Binding SupplierName}" />
                                </WrapPanel>
                                <ui:TextBlock Text="{Binding SupplierCode}"
                                              Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{resx:Localization propSupplierReferenceNo}" />
                <ui:TextBox Text="{Binding VM.Data.SupplierReferenceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{resx:Localization propCurrencyId}"
                           Margin="0,5,0,5" />
                <WrapPanel Width="210"
                           HorizontalAlignment="Left">
                    <RadioButton Content="IDR"
                                 GroupName="CurrencyId"
                                 IsChecked="{Binding VM.Data.CurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.IDR}}"
                                 MinWidth="70"
                                 Width="50"
                                 Checked="CurrencyRadioButton_Checked"
                                 />
                    <RadioButton Content="CNY"
                                 GroupName="CurrencyId"
                                 IsChecked="{Binding VM.Data.CurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.CNY}}"
                                 MinWidth="70"
                                 Width="70"
                                 Checked="CurrencyRadioButton_Checked" />
                    <RadioButton Content="USD"
                                 GroupName="CurrencyId"
                                 IsChecked="{Binding VM.Data.CurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.USD}}"
                                 MinWidth="70"
                                 Width="70"
                                 Checked="CurrencyRadioButton_Checked" />
                </WrapPanel>

                <TextBlock Text="{resx:Localization propCurrencyRate}" />
                <ui:NumberBox x:Name="CurrencyRateNUD"
                              Value="{Binding VM.Data.CurrencyRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              LargeChange="0"
                              SmallChange="0"
                              MaxDecimalPlaces="4" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{resx:Localization propDPP}" />
                        <ui:NumberBox x:Name="HeaderTotalDPPNUD"
                                      Value="{Binding VM.Data.DPP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      SpinButtonPlacementMode="Hidden"
                                      MaxDecimalPlaces="{Binding VM.Data.Rounding, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{resx:Localization propDPPDiscount}" />
                        <ui:NumberBox x:Name="HeaderDPPDiscountNUD"
                                      Value="{Binding VM.Data.DPPDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      SpinButtonPlacementMode="Hidden"
                                      MaxDecimalPlaces="{Binding VM.Data.Rounding, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{resx:Localization propTotalAmount}" />
                        <ui:NumberBox x:Name="HeaderTotalAmountNUD"
                                      Value="{Binding VM.Data.TotalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      SpinButtonPlacementMode="Hidden"
                                      MaxDecimalPlaces="{Binding VM.Data.Rounding, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{resx:Localization propDPP}" />
                        <ui:NumberBox x:Name="HeaderTotalDPPIDRNUD"
                                      Value="{Binding VM.Data.DPPIDR, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="0"
                                      IsReadOnly="True"
                                      Background="LightYellow" />

                        <TextBlock Text="{resx:Localization propDPPDiscount}" />
                        <ui:NumberBox x:Name="HeaderDPPDiscountIDRNUD"
                                      Value="{Binding VM.Data.DPPIDRDiscount, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="0"
                                      IsReadOnly="True"
                                      Background="LightYellow" />

                        <TextBlock Text="{resx:Localization propTotalAmount}" />
                        <ui:NumberBox x:Name="HeaderTotalAmountIDRNUD"
                                      Value="{Binding VM.Data.TotalAmountIDR, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="0"
                                      IsReadOnly="True"
                                      Background="LightYellow" />

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

        <StackPanel x:Name="InputContainer1"
                    Grid.Column="1"
                    Margin="10,0,0,0">

            <TextBlock Text="{resx:Localization propFinanceDetail}"
                       Margin="0,5,0,5" />
            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="10"
                    Width="900"
                    Height="200"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <DataGrid x:Name="ItemDetailDataGrid"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              SelectedItem="{Binding VM.SelectedFinanceDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding VM.Data.FinanceDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="200"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{resx:Localization propPaidAt}"
                                                Binding="{Binding PaidAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True"
                                                Width="200" />

                            <DataGridTextColumn Header="{resx:Localization propCurrencyId}"
                                                Binding="{Binding PaidCurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True"
                                                Width="100" />

                            <!-- N0 Columns -->
                            <DataGridTextColumn Header="{resx:Localization propCurrencyRate}"
                                                Binding="{Binding PaidCurrencyRate, StringFormat=N0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding Data.VM.Data.N0Visibility, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propPaidAmount}"
                                                Binding="{Binding PaidAmount, StringFormat=N0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding Data.VM.Data.N0Visibility, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                IsReadOnly="False" />

                            <!-- N2 Columns -->
                            <DataGridTextColumn Header="{resx:Localization propCurrencyRate}"
                                                Binding="{Binding PaidCurrencyRate, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding Data.VM.Data.N2Visibility, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propPaidAmount}"
                                                Binding="{Binding PaidAmount, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding Data.VM.Data.N2Visibility, Mode=OneWay, Source={StaticResource Page1}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                IsReadOnly="False" />

                            <!-- Note -->
                            <DataGridTextColumn Header="{resx:Localization propNote}"
                                                Binding="{Binding PaidNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True"
                                                Width="300" />

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <WrapPanel Margin="0,5,0,5">
                <Border BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="10"
                        Padding="10"
                        Width="400">
                    <StackPanel>
                        <Menu Height="50"
                              BorderThickness="0,1,0,1"
                              BorderBrush="Gray"
                              Margin="0,5,0,5">
                            <MenuItem Header="{resx:Localization btnAdd}"
                                      Icon="{ui:SymbolIcon Add24}"
                                      Command="{Binding VM.AddFinanceDetailCommand, Mode=OneWay}"
                                      IsCheckable="True"
                                      IsChecked="{Binding VM.AddCommandChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="100" />

                            <MenuItem Header="{resx:Localization btnDelete}"
                                      Icon="{ui:SymbolIcon Delete24}"
                                      Command="{Binding VM.DeleteFinanceDetailCommand, Mode=OneWay}"
                                      Width="100" />

                        </Menu>

                        <TextBlock Text="{resx:Localization propPaidAt}"
                                   Margin="0,5,0,5" />
                        <WrapPanel>
                            <ui:TextBox Text="{Binding VM.SelectedFinanceDetail.PaidAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='dd MMM yyyy'}"
                                        IsReadOnly="True"
                                        Margin="0,0,5,0" />

                            <ui:CalendarDatePicker Date="{Binding VM.SelectedFinanceDetail.PaidAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        </WrapPanel>

                        <TextBlock Text="{resx:Localization propCurrencyId}"
                                   Margin="0,5,0,5" />
                        <WrapPanel Width="210"
                                   HorizontalAlignment="Left">
                            <RadioButton Content="IDR"
                                         GroupName="PaidCurrencyId"
                                         IsChecked="{Binding VM.SelectedFinanceDetail.PaidCurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.IDR}}"
                                         MinWidth="70"
                                         Width="50"
                                         Checked="PaidCurrencyRadioButton_Checked" />
                            <RadioButton Content="CNY"
                                         GroupName="PaidCurrencyId"
                                         IsChecked="{Binding VM.SelectedFinanceDetail.PaidCurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.CNY}}"
                                         MinWidth="70"
                                         Width="70"
                                         Checked="PaidCurrencyRadioButton_Checked" />
                            <RadioButton Content="USD"
                                         GroupName="PaidCurrencyId"
                                         IsChecked="{Binding VM.SelectedFinanceDetail.PaidCurrencyIdEnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static data0:CurrencyIdEnum.USD}}"
                                         MinWidth="70"
                                         Width="70"
                                         Checked="PaidCurrencyRadioButton_Checked" />
                        </WrapPanel>

                        <TextBlock Text="{resx:Localization propCurrencyRate}" />
                        <ui:NumberBox x:Name="PaidCurrencyRateNUD"
                                      Value="{Binding VM.SelectedFinanceDetail.PaidCurrencyRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4" />

                        <TextBlock Text="{resx:Localization propAmount}" />
                        <ui:NumberBox x:Name="PaidAmountNUD"
                                      Value="{Binding VM.SelectedFinanceDetail.PaidAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4" />

                        <TextBlock Text="{resx:Localization propNote}" />
                        <ui:TextBox Text="{Binding VM.SelectedFinanceDetail.PaidNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True"
                                    Height="300"/>

                    </StackPanel>
                </Border>

            </WrapPanel>

        </StackPanel>

        <Viewbox x:Name="MessageBox"
                 Stretch="None"
                 VerticalAlignment="Top"
                 Margin="0,10,0,0"
                 MaxWidth="{Binding ActualWidth, ElementName=MainGrid}"
                 Grid.Column="0"
                 Grid.ColumnSpan="2">
            <Frame x:Name="MessageFrame"
                   Visibility="Collapsed"
                   MaxWidth="{Binding ActualWidth, ElementName=MainGrid}" />
        </Viewbox>
    </Grid>
    <!--</ScrollViewer>-->
</Page>
