<Page x:Class="ManagementSystem.WPF.UI.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Margin="10,0,10,10">

    <Border CornerRadius="5"
            BorderBrush="Gray"
            BorderThickness="2">
        <StackPanel>
            <TextBlock Text="{resx:Localization spLanguage}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="10" />
            <RadioButton Content="{resx:Localization spEnglish}"
                         GroupName="Language"
                         Margin="10,0,0,0"
                         Command="{Binding VM.IsEnglishSelectedCommand, Mode=OneWay}"
                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
            <RadioButton Content="{resx:Localization spBahasa}"
                         GroupName="Language"
                         Margin="10,0,0,0"
                         Command="{Binding VM.IsBahasaSelectedCommand, Mode=OneWay}"
                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
            
            <TextBlock Text="{resx:Localization spTheme}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="10" />
            <RadioButton Content="{resx:Localization spThemeLight}"
                         GroupName="Language"
                         Margin="10,0,0,0"
                         Command="{Binding VM.IsThemeLightSelectedCommand, Mode=OneWay}"
                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
            <RadioButton Content="{resx:Localization spThemeDark}"
                         GroupName="Language"
                         Margin="10,0,0,0"
                         Command="{Binding VM.IsThemeDarkSelectedCommand, Mode=OneWay}"
                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
        </StackPanel>
    </Border>
    
</Page>
