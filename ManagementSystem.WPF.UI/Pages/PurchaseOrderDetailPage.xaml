<Page x:Class="ManagementSystem.WPF.UI.Pages.PurchaseOrderDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:C="clr-namespace:ManagementSystem.WPF.UI.Controls"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:vm="clr-namespace:ManagementSystem.WPF.UI.ViewModels"
      xmlns:data="clr-namespace:ManagementSystem.WPF.UI.Data.DBModels;assembly=ManagementSystem.WPF.UI.Data"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:PurchaseOrderDetailPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="{Binding VM.Title, Mode=OneTime}"
      Margin="10">

    <Grid x:Name="MainGrid">
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>-->

        <StackPanel x:Name="InputContainer">
            <TextBlock Text="{resx:Localization propPOCode}"
                       Margin="0,5,0,5" />
            <ui:TextBox Text="{Binding VM.Data.POCode}"
                        IsReadOnly="True"
                        Width="200"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Left" />

            <TextBlock Text="{resx:Localization propPODate}"
                       Margin="0,5,0,5" />
            <WrapPanel>
                <ui:TextBox Text="{Binding VM.Data.PODate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='dd MMM yyyy'}"
                            IsReadOnly="True"
                            Width="150"
                            Margin="0,0,5,0" />

                <ui:CalendarDatePicker Date="{Binding VM.Data.PODate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       IsEnabled="{Binding VM.CanEditPODate}" />

            </WrapPanel>

            <TextBlock Text="{resx:Localization propPODetail}"
                       Margin="0,5,0,5" />
            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="10"
                    Width="600"
                    Height="200"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <DataGrid x:Name="ItemDetailDataGrid"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              SelectedItem="{Binding VM.SelectedPOD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding VM.Data.PurchaseOrderDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="200"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{resx:Localization propItemCode}"
                                                Binding="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True"
                                                Width="200" />

                            <DataGridTextColumn Header="{resx:Localization propItemName}"
                                                Binding="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True"
                                                Width="300" />

                            <DataGridTextColumn Header="{resx:Localization propQty}"
                                                Binding="{Binding Qty, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propUnitPrice}"
                                                Binding="{Binding UnitPrice, StringFormat=N4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propUnitPriceDiscount}"
                                                Binding="{Binding UnitPriceDiscount, StringFormat=N4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propDPP}"
                                                Binding="{Binding DPP, StringFormat=N4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" />

                            <DataGridTextColumn Header="{resx:Localization propTotalAmount}"
                                                Binding="{Binding TotalAmount, StringFormat=N4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False" />

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

            <WrapPanel Margin="0,5,0,5">
                <Border BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="10"
                        Padding="10"
                        Width="400">
                    <StackPanel>
                        <Menu Height="50"
                              BorderThickness="0,1,0,1"
                              BorderBrush="Gray"
                              Margin="0,5,0,5">
                            <MenuItem Header="{resx:Localization btnAdd}"
                                      Icon="{ui:SymbolIcon Add24}"
                                      Command="{Binding VM.AddPODCommand, Mode=OneWay}"
                                      IsCheckable="True"
                                      IsChecked="{Binding VM.AddCommandChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="100" />

                            <MenuItem Header="{resx:Localization btnDelete}"
                                      Icon="{ui:SymbolIcon Delete24}"
                                      Command="{Binding VM.DeletePODCommand, Mode=OneWay}"
                                      Width="100" />

                        </Menu>

                        <TextBlock Text="{resx:Localization propItemCode}" />
                        <ui:TextBox Text="{Binding VM.SelectedPOD.ItemCode}"
                                    IsEnabled="False" />

                        <TextBlock Text="{resx:Localization propItemName}" />
                        <ComboBox x:Name="ItemComboBox"
                                  ItemsSource="{Binding VM.FilteredView}"
                                  SelectedItem="{Binding VM.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsTextSearchEnabled="False"
                                  IsTextSearchCaseSensitive="False"
                                  IsEditable="True"
                                  IsReadOnly="False"
                                  ScrollViewer.CanContentScroll="True"
                                  TextSearch.TextPath="ItemName"
                                  PreviewKeyDown="ItemComboBox_PreviewKeyDown"
                                  KeyUp="ItemComboBox_NUD_KeyUp"
                                  SelectedIndex="{Binding VM.ItemSelectedIndex, Mode=OneWay}">

                            <!--Text="{Binding VM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"-->
                            <!--PreviewKeyDown="ItemComboBox_PreviewKeyDown"-->
                            <!--DropDownOpened="MyComboBox_DropDownOpened"-->
                            <!--SelectedIndex="{Binding VM.ItemSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                            <!--SelectedValue="{Binding VM.SelectedItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <EventSetter Event="PreviewMouseMove"
                                                 Handler="ItemComboBox_OnPreviewMouseMove" />
                                    <EventSetter Event="MouseLeave"
                                                 Handler="ItemComboBox_OnItemHoverExit" />
                                </Style>
                            </ComboBox.ItemContainerStyle>

                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="data:MstItem">
                                    <StackPanel Width="300">
                                        <WrapPanel>
                                            <ui:TextBlock Text="{Binding Askterisk}"
                                                          Width="10" />
                                            <ui:TextBlock Text="{Binding ItemName}" />
                                        </WrapPanel>
                                        <ui:TextBlock Text="{Binding ItemCode}"
                                                      Margin="10,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{resx:Localization propQty}" />
                        <ui:NumberBox x:Name="QtyNUD"
                                      Value="{Binding VM.SelectedPOD.Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="2"
                                      KeyUp="ItemComboBox_NUD_KeyUp" />

                        <TextBlock Text="{resx:Localization propUnitPrice}" />
                        <ui:NumberBox x:Name="UnitPriceNUD"
                                      Value="{Binding VM.SelectedPOD.UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4"
                                      KeyUp="ItemComboBox_NUD_KeyUp" />

                        <TextBlock Text="{resx:Localization propUnitPriceDiscount}" />
                        <ui:NumberBox x:Name="UnitPriceDiscountNUD"
                                      Value="{Binding VM.SelectedPOD.UnitPriceDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4"
                                      KeyUp="ItemComboBox_NUD_KeyUp" />

                        <TextBlock Text="{resx:Localization propDPP}" />
                        <ui:NumberBox x:Name="DPPNUD"
                                      Value="{Binding VM.SelectedPOD.DPP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4"
                                      KeyUp="ItemComboBox_NUD_KeyUp" />

                        <TextBlock Text="{resx:Localization propTotalAmount}" />
                        <ui:NumberBox x:Name="TotalAmountNUD"
                                      Value="{Binding VM.SelectedPOD.TotalAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      LargeChange="0"
                                      SmallChange="0"
                                      MaxDecimalPlaces="4"
                                      KeyUp="ItemComboBox_NUD_KeyUp" />

                    </StackPanel>
                </Border>

                <Border BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="10"
                        Margin="5,0,0,0">
                    <Image Source="{Binding VM.PreviewImagePath, Mode=OneWay}"
                           Width="195" />
                </Border>

            </WrapPanel>

        </StackPanel>

        <Viewbox x:Name="MessageBox"
                 Stretch="None"
                 VerticalAlignment="Top"
                 Margin="0,10,0,0"
                 MaxWidth="{Binding ActualWidth, ElementName=MainGrid}">
            <Frame x:Name="MessageFrame"
                   Visibility="Collapsed"
                   MaxWidth="{Binding ActualWidth, ElementName=MainGrid}" />
        </Viewbox>
    </Grid>
</Page>
