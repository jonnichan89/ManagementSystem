<Page x:Class="ManagementSystem.WPF.UI.Pages.MstSupplierDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:C="clr-namespace:ManagementSystem.WPF.UI.Controls"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:vm="clr-namespace:ManagementSystem.WPF.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:MstSupplierDetailPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="{Binding VM.Title, Mode=OneTime}"
      Margin="10"
      MinWidth="450">

    <Grid x:Name="MainGrid">
        <StackPanel x:Name="InputContainer">
            <TextBlock Text="{resx:Localization propSupplierCode}" />
            <ui:TextBox Text="{Binding VM.Data.SupplierCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsReadOnly="{Binding VM.CanEditSupplierCode}"
                        />

            <TextBlock Text="{resx:Localization propSupplierName}" />
            <ui:TextBox Text="{Binding VM.Data.SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{resx:Localization propSupplierUsedIn}" />
            <GroupBox>
                <WrapPanel>
                    <CheckBox Content="{resx:Localization mwPurchase}"
                              IsChecked="{Binding VM.Data.UsedInPO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,5,0"/>

                    <CheckBox Content="{resx:Localization mwSales}"
                              IsChecked="{Binding VM.Data.UsedInSO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,5,0" />

                    <CheckBox Content="{resx:Localization mwProjectPurchaseOrder}"
                              IsChecked="{Binding VM.Data.UsedInPPO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,5,0" />

                    <CheckBox Content="{resx:Localization mwProjectSalesOrder}"
                              IsChecked="{Binding VM.Data.UsedInPSO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,5,0" />
                    
                </WrapPanel>
                
            </GroupBox>

            <CheckBox Content="{resx:Localization propIsBlacklist}"
                      IsChecked="{Binding VM.Data.IsBlacklist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            
        </StackPanel>

        <Viewbox x:Name="MessageBox" Stretch="None" VerticalAlignment="Top" Margin="0,10,0,0">
            <Frame x:Name="MessageFrame"
                   Visibility="Collapsed" />
        </Viewbox>
    </Grid>
</Page>
