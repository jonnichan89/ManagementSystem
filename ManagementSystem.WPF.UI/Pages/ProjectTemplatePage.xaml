<Page x:Class="ManagementSystem.WPF.UI.Pages.ProjectTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:conv="clr-namespace:ManagementSystem.WPF.UI.Converters"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:ProjectTemplatePage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Purchase Order"
      Margin="10,0,10,10"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <conv:FileToImageConverter x:Key="FileToImageConverter" />
        <conv:RadioButtonConverter x:Key="RadioButtonConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <Border CornerRadius="5"
            BorderBrush="Gray"
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="0.25*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Menu Height="50"
                  Grid.Row="0">
                <MenuItem Header="{resx:Localization btnAdd}"
                          Icon="{ui:SymbolIcon Add24}"
                          Command="{Binding VM.AddCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnEdit}"
                          Icon="{ui:SymbolIcon Edit24}"
                          Command="{Binding VM.EditCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnDelete}"
                          Icon="{ui:SymbolIcon Delete24}"
                          Command="{Binding VM.DeleteCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnRefresh}"
                          Icon="{ui:SymbolIcon ArrowClockwise24}"
                          Command="{Binding VM.RefreshPreviewItemsCommand, Mode=OneWay}"
                          Width="100" />

            </Menu>

            <Expander Header="{resx:Localization Filter}"
                      Grid.Row="1">
                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Search:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBox Width="200"
                             Margin="0,0,10,0" />

                    <GroupBox Header="{resx:Localization PreviewMode}"
                              Margin="0,10,0,0">
                        <WrapPanel Orientation="Horizontal"
                                   Margin="10">
                            <RadioButton Content="{resx:Localization PreviewModeList}"
                                         IsChecked="{Binding VM.PreviewMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=List}" />
                            <RadioButton Content="{resx:Localization PreviewModeImage}"
                                         IsChecked="{Binding VM.PreviewMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Image}" />
                        </WrapPanel>
                    </GroupBox>
                    
                    <GroupBox Header="{resx:Localization PreviewModeListImageMode}"
                              Margin="0,10,0,0">
                        <WrapPanel Orientation="Horizontal"
                                   Margin="10">
                            <RadioButton Content="{resx:Localization PreviewModeListImageCollapsed}"
                                         IsChecked="{Binding VM.PreviewModeListImageMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Collapsed}" />
                            <RadioButton Content="{resx:Localization PreviewModeListImageVisible}"
                                         IsChecked="{Binding VM.PreviewModeListImageMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Visible}" />
                            <RadioButton Content="{resx:Localization PreviewModeListImageVisibleWhenSelected}"
                                         IsChecked="{Binding VM.PreviewModeListImageMode, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=VisibleWhenSelected}" />
                        </WrapPanel>
                    </GroupBox>
                    
                </StackPanel>

            </Expander>

            <Grid Margin="2,0"
                  Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Column for the splitter (Width="Auto" sizes it to fit the splitter's width) -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              Visibility="{Binding VM.PreviewMode, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Image}">

                    <ListBox ItemsSource="{Binding VM.PreviewItems, UpdateSourceTrigger=PropertyChanged}"
                             SelectedItem="{Binding VM.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- Arrange items left-to-right, wrapping downward -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <!-- Display ONLY the image for each item in the list -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10">
                                    <Border Background="#F4F4F4"
                                            Padding="50"
                                            BorderBrush="#DDD"
                                            BorderThickness="0,1,0,1"
                                            Height="200"
                                            HorizontalAlignment="Left"
                                            CornerRadius="10">
                                        <Image Source="{Binding ImagePath, 
                                                        Mode=OneWay,
                                                        Converter={StaticResource FileToImageConverter}}" />
                                    </Border>
                                    <TextBlock Text="{Binding ProjectTemplates[0].PTName}"
                                               Width="200"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </ScrollViewer>

                <DataGrid Grid.Column="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectedItem="{Binding VM.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding VM.PreviewItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          RowDetailsVisibilityMode="{Binding VM.RowDetailsVisibilityMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding VM.PreviewMode, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=List}">
                    
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="LightGray" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="Black" />
                    </DataGrid.Resources>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding"
                                    Value="3,3,3,3" />
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{resx:Localization propPTName}"
                                            Binding="{Binding DisplayPTName}" />

                        <DataGridTextColumn Header="{resx:Localization propCreatedAt}"
                                            Binding="{Binding CreatedAt, StringFormat='dd MMM yyyy HH:mm'}" />

                        <DataGridTextColumn Header="{resx:Localization propModifiedAt}"
                                            Binding="{Binding ModifiedAt, StringFormat='dd MMM yyyy HH:mm'}" />

                    </DataGrid.Columns>

                    <!-- Collapsible Accordion Content Pannel -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F4F4F4"
                                    Padding="15"
                                    BorderBrush="#DDD"
                                    BorderThickness="0,1,0,1"
                                    Height="200"
                                    HorizontalAlignment="Left">
                                <Image Source="{Binding ImagePath, 
                                                Mode=OneWay,
                                                Converter={StaticResource FileToImageConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <!-- Vertical GridSplitter -->
                <GridSplitter Grid.Column="1"
                              Width="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Gray"
                              ShowsPreview="True"
                              Margin="2,0" />

                <Image Grid.Column="2"
                       Source="{Binding
                            VM.SelectedItem.ImagePath, 
                            Mode=OneWay,
                            Converter={StaticResource FileToImageConverter}}" />

                <!--<DataGrid Grid.Column="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding VM.PSDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="LightGray" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="Black" />
                    </DataGrid.Resources>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding"
                                    Value="3,3,3,3" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{resx:Localization propItemCode}"
                                            Binding="{Binding ItemCode}" />

                        <DataGridTextColumn Header="{resx:Localization propQty}"
                                            Binding="{Binding Qty, StringFormat=N2}" />

                        <DataGridTextColumn Header="{resx:Localization propUnit}"
                                            Binding="{Binding Unit}" />

                    </DataGrid.Columns>

                </DataGrid>-->

            </Grid>

            <ItemsControl ItemsSource="{Binding VM.PageList}"
                          Grid.Row="3">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding PageText}"
                                   Command="{Binding VM.RefreshPreviewItemsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
                                   CommandParameter="{Binding}"
                                   Width="40"
                                   Height="40"
                                   Margin="5,5,0,5">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button"
                                       BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="AntiqueWhite" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

    </Border>

</Page>
