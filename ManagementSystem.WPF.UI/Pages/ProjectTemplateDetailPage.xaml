<Page x:Class="ManagementSystem.WPF.UI.Pages.ProjectTemplateDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:h="clr-namespace:ManagementSystem.WPF.UI.Helpers"
      xmlns:C="clr-namespace:ManagementSystem.WPF.UI.Controls"
      xmlns:conv="clr-namespace:ManagementSystem.WPF.UI.Converters"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:vm="clr-namespace:ManagementSystem.WPF.UI.ViewModels"
      xmlns:data="clr-namespace:ManagementSystem.WPF.UI.Data.DBModels;assembly=ManagementSystem.WPF.UI.Data"
      xmlns:data0="clr-namespace:ManagementSystem.WPF.UI.Data;assembly=ManagementSystem.WPF.UI.Data"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:ProjectTemplateDetailPage, IsDesignTimeCreatable=False}"
      Title="{Binding VM.Title, Mode=OneTime}"
      Margin="10"
      d:Background="LightGray">
    <Page.Resources>
        <h:BindingProxy x:Key="Page1"
                        Data="{Binding}" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <conv:FileToImageConverter x:Key="FileToImageConverter" />
    </Page.Resources>

    <!--<ScrollViewer CanContentScroll="True"
                  HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Visible">-->
    <Grid x:Name="MainGrid">
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>-->


        <StackPanel x:Name="InputContainer">

            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    Margin="5,0,0,0">
                <WrapPanel Margin="10">
                    <Border BorderThickness="1"
                            BorderBrush="Gray"
                            CornerRadius="5">
                        <StackPanel Margin="5,0,5,0">
                            <Menu Height="50"
                                  BorderThickness="0,0,0,1"
                                  BorderBrush="Gray"
                                  Margin="0,5,0,5">
                                <MenuItem Header="{resx:Localization btnAdd}"
                                          Icon="{ui:SymbolIcon Add24}"
                                          Command="{Binding VM.AddDataCommand, Mode=OneWay}"
                                          IsCheckable="True"
                                          IsChecked="{Binding VM.AddDataCommandChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="100" />

                                <Separator BorderBrush="#55000000"
                                           BorderThickness="1" />

                                <MenuItem Header="{resx:Localization btnDelete}"
                                          Icon="{ui:SymbolIcon Delete24}"
                                          Command="{Binding VM.DeleteDataCommand, Mode=OneWay}"
                                          Width="100" />

                            </Menu>

                            <DataGrid x:Name="ProjectTemplateDataGrid"
                                      CanUserAddRows="False"
                                      AutoGenerateColumns="False"
                                      SelectedItem="{Binding VM.SelectedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding VM.Data.ProjectTemplates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="200"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{resx:Localization propPTName}"
                                                        Binding="{Binding PTName, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="200" />

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                    <Border BorderThickness="1"
                            BorderBrush="Gray"
                            CornerRadius="5"
                            HorizontalAlignment="Left"
                            Margin="5,0,0,0"
                            Width="300">
                        <StackPanel Margin="5">
                            <TextBlock Text="{resx:Localization propPTName}"
                                       Margin="0,5,0,5" />
                            <ui:TextBox Text="{Binding VM.SelectedData.PTName}"
                                        HorizontalContentAlignment="Stretch" />

                            <TextBlock Text="{resx:Localization propImagePath}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding VM.SelectedData.ImagePathToUpload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" />
                                <ui:Button Grid.Column="1"
                                           Content="..."
                                           Command="{Binding VM.DataPickImageFileCommand}" />
                            </Grid>

                            <TextBlock Text="{resx:Localization propNote}"
                                       Margin="0,5,0,5" />
                            <ui:TextBox Text="{Binding VM.SelectedData.Note}"
                                        AcceptsReturn="True"
                                        Height="100"
                                        HorizontalContentAlignment="Stretch" />
                        </StackPanel>

                    </Border>

                    <Border BorderThickness="1"
                            BorderBrush="Gray"
                            CornerRadius="5"
                            Margin="5,0,0,0">
                        <Image Source="{Binding
                            VM.SelectedData.ImagePath, 
                            Mode=OneWay,
                            Converter={StaticResource FileToImageConverter}}"
                               Width="200"
                               Margin="5" />
                    </Border>

                </WrapPanel>

            </Border>

            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="10"
                    Margin="5,5,0,0">
                <StackPanel x:Name="InputContainer1"
                            Margin="10,0,0,0">

                    <TextBlock Text="{resx:Localization propItemDetail}"
                               Margin="0,5,0,5" />

                    <Border BorderThickness="1"
                            BorderBrush="Gray"
                            CornerRadius="5">

                        <StackPanel Margin="5">

                            <Menu Height="50"
                                  BorderThickness="0,0,0,1"
                                  BorderBrush="Gray"
                                  Margin="0,5,0,5">
                                <MenuItem Header="{resx:Localization btnAdd}"
                                          Icon="{ui:SymbolIcon Add24}"
                                          Command="{Binding VM.AddDataDetailCommand, Mode=OneWay}"
                                          IsCheckable="True"
                                          IsChecked="{Binding VM.AddDataDetailCommandChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="100" />

                                <Separator BorderBrush="#55000000"
                                           BorderThickness="1" />

                                <MenuItem Header="{resx:Localization btnDelete}"
                                          Icon="{ui:SymbolIcon Delete24}"
                                          Command="{Binding VM.DeleteDataDetailCommand, Mode=OneWay}"
                                          Width="100" />

                            </Menu>

                            <DataGrid x:Name="DataDetailDataGrid"
                                      CanUserAddRows="False"
                                      AutoGenerateColumns="False"
                                      SelectedItem="{Binding VM.SelectedDataDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding VM.SelectedData.ProjectTemplateDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="200"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{resx:Localization propItemCode}"
                                                        Binding="{Binding ItemCode, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="200" />

                                    <DataGridTextColumn Header="{resx:Localization propItemName}"
                                                        Binding="{Binding ItemName, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="300" />

                                    <DataGridTextColumn Header="{resx:Localization propQty}"
                                                        Binding="{Binding Qty, StringFormat=N0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        IsReadOnly="False" />

                                    <DataGridTextColumn Header="{resx:Localization propUnit}"
                                                        Binding="{Binding Unit, Mode=OneWay}"
                                                        IsReadOnly="True" />

                                </DataGrid.Columns>

                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,5,0,5">
                        
                        <Border BorderThickness="1"
                                BorderBrush="Gray"
                                CornerRadius="5">
                            
                            <WrapPanel Margin="5">
                                <StackPanel Width="300">
                                    <TextBlock Text="{resx:Localization propItemCode}" />
                                    <ui:TextBox Text="{Binding VM.SelectedDataDetail.ItemCode}"
                                                IsEnabled="False" />

                                    <TextBlock Text="{resx:Localization propItemName}" />
                                    <ComboBox x:Name="ItemComboBox"
                                              ItemsSource="{Binding VM.FilteredItem}"
                                              SelectedItem="{Binding VM.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsTextSearchEnabled="False"
                                              IsTextSearchCaseSensitive="False"
                                              IsEditable="True"
                                              IsReadOnly="False"
                                              ScrollViewer.CanContentScroll="True"
                                              TextSearch.TextPath="ItemName"
                                              PreviewKeyDown="ItemComboBox_PreviewKeyDown"
                                              KeyUp="ItemComboBox_NUD_KeyUp"
                                              SelectedIndex="{Binding VM.ItemSelectedIndex, Mode=OneWay}">

                                        <!--Text="{Binding VM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"-->
                                        <!--PreviewKeyDown="ItemComboBox_PreviewKeyDown"-->
                                        <!--DropDownOpened="MyComboBox_DropDownOpened"-->
                                        <!--SelectedIndex="{Binding VM.ItemSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                                        <!--SelectedValue="{Binding VM.SelectedItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <EventSetter Event="PreviewMouseMove"
                                                             Handler="ItemComboBox_OnPreviewMouseMove" />
                                                <EventSetter Event="MouseLeave"
                                                             Handler="ItemComboBox_OnItemHoverExit" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>

                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel VirtualizationMode="Recycling" />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="data:MstItem">
                                                <StackPanel Width="300">
                                                    <WrapPanel>
                                                        <ui:TextBlock Text="{Binding Askterisk}"
                                                                      Width="10" />
                                                        <ui:TextBlock Text="{Binding ItemName}" />
                                                    </WrapPanel>
                                                    <ui:TextBlock Text="{Binding ItemCode}"
                                                                  Margin="10,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="{resx:Localization propQty}" />
                                    <WrapPanel>
                                        <ui:NumberBox x:Name="QtyNUD"
                                                      Value="{Binding VM.SelectedDataDetail.Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      LargeChange="0"
                                                      SmallChange="0"
                                                      MaxDecimalPlaces="2"
                                                      Width="150"
                                                      KeyUp="ItemComboBox_NUD_KeyUp" />
                                        <ui:ClientAreaBorder BorderThickness="1"
                                                             BorderBrush="#33808080"
                                                             CornerRadius="5"
                                                             Margin="3,0,0,0">
                                            <ui:TextBlock Text="{Binding VM.SelectedDataDetail.Unit, Mode=OneWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,10,0" />
                                        </ui:ClientAreaBorder>
                                    </WrapPanel>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <Border BorderThickness="1"
                                BorderBrush="Gray"
                                CornerRadius="10"
                                Margin="5,0,0,0">
                            <Image Source="{Binding
                                VM.DataDetailPreviewImagePath, 
                                Mode=OneWay,
                                Converter={StaticResource FileToImageConverter}}"
                                   Width="200"
                                   Margin="5" />
                        </Border>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </StackPanel>

        <Viewbox x:Name="MessageBox"
                 Stretch="None"
                 VerticalAlignment="Top"
                 Margin="0,10,0,0"
                 MaxWidth="{Binding ActualWidth, ElementName=MainGrid}"
                 Grid.Column="0"
                 Grid.ColumnSpan="2">
            <Frame x:Name="MessageFrame"
                   Visibility="Collapsed"
                   MaxWidth="{Binding ActualWidth, ElementName=MainGrid}" />
        </Viewbox>
    </Grid>
    <!--</ScrollViewer>-->
</Page>
