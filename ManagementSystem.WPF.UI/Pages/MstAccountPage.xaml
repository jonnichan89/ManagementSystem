<Page x:Class="ManagementSystem.WPF.UI.Pages.MstAccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
      xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
      xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:MstAccountPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MstAccountPage"
      Margin="10,0,10,10"
      ScrollViewer.CanContentScroll="False">

    <Border CornerRadius="5"
            BorderBrush="Gray"
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Menu Height="50"
                  Grid.Row="0">
                <MenuItem Header="{resx:Localization btnAdd}"
                          Icon="{ui:SymbolIcon Add24}"
                          Command="{Binding VM.AddCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnEdit}"
                          Icon="{ui:SymbolIcon Edit24}"
                          Command="{Binding VM.EditCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnDelete}"
                          Icon="{ui:SymbolIcon Delete24}"
                          Command="{Binding VM.DeleteCommand, Mode=OneWay}"
                          Width="100" />

                <MenuItem Header="{resx:Localization btnRefresh}"
                          Icon="{ui:SymbolIcon ArrowClockwise24}"
                          Command="{Binding VM.RefreshPreviewItemsCommand, Mode=OneWay}"
                          Width="100" />

            </Menu>

            <Expander Header="{resx:Localization Filter}"
                      Grid.Row="1">
                <StackPanel Orientation="Horizontal"
                            Margin="10">
                    <TextBlock Text="Search:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBox Width="200"
                             Margin="0,0,10,0" />
                </StackPanel>
                
            </Expander>

            <DataGrid Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectedItem="{Binding VM.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding VM.PreviewItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                     Color="LightGray" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                     Color="Black" />
                </DataGrid.Resources>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="3,3,3,3" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{resx:Localization propAccountCode}"
                                        Binding="{Binding AccountCode}" />

                    <DataGridTextColumn Header="{resx:Localization propAccountName}"
                                        Binding="{Binding AccountName}" />

                    <DataGridTemplateColumn Header="{resx:Localization propIsBlacklist}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsBlacklist}"
                                          IsEnabled="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{resx:Localization propCreatedAt}"
                                        Binding="{Binding CreatedAt, StringFormat='dd MMM yyyy HH:mm'}" />

                    <DataGridTextColumn Header="{resx:Localization propModifiedAt}"
                                        Binding="{Binding ModifiedAt, StringFormat='dd MMM yyyy HH:mm'}" />

                </DataGrid.Columns>
                
            </DataGrid>

            <ItemsControl ItemsSource="{Binding VM.PageList}"
                          Grid.Row="3">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding PageText}"
                                   Command="{Binding VM.RefreshPreviewItemsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Page}}}"
                                   CommandParameter="{Binding}"
                                   Width="40"
                                   Height="40"
                                   Margin="5,5,0,5">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button"
                                       BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="AntiqueWhite" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
        
    </Border>
    
</Page>
