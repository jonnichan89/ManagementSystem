<Window x:Class="ManagementSystem.WPF.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Splash"
        Width="460"
        Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Grid>
        <Border Background="White"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,8">
                    <TextBlock Text="ManagementSystem"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#222"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Loading, please wait…"
                               FontSize="12"
                               Foreground="#666"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1"
                      VerticalAlignment="Center">
                    <!-- Placeholder for logo or illustration -->
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Vertical"
                            Margin="0,8,0,0">
                    <ProgressBar IsIndeterminate="True"
                                 Height="8" />
                    <TextBlock x:Name="StatusText"
                               Text="Initializing..."
                               FontSize="11"
                               Foreground="#666"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>