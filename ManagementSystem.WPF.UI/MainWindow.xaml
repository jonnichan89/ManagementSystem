<ui:FluentWindow x:Class="ManagementSystem.WPF.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:resx="clr-namespace:ManagementSystem.WPF.UI.Resources"
                 xmlns:local="clr-namespace:ManagementSystem.WPF.UI"
                 xmlns:pages="clr-namespace:ManagementSystem.WPF.UI.Pages"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=False}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Title="Management System"
                 Height="450"
                 Width="800"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized">
    <Grid>
        <ui:NavigationView x:Name="NavigationView"
                           PaneDisplayMode="Left"
                           PaneTitle="{resx:Localization mwTitle}"
                           >
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{resx:Localization mwDashboard}"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem x:Name="NavMaster"
                                       Content="{resx:Localization mwMaster}"
                                       Icon="{ui:SymbolIcon BookDatabase24}"
                                       Click="NavMaster_Click">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{resx:Localization mwMstUser}"
                                               Icon="{ui:SymbolIcon Person24}"
                                               TargetPageType="{x:Type pages:MstUserPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwMstSupplier}"
                                               Icon="{ui:SymbolIcon People24}"
                                               TargetPageType="{x:Type pages:MstSupplierPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwMstItem}"
                                               Icon="{ui:SymbolIcon Box24}"
                                               TargetPageType="{x:Type pages:MstItemPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwMstAccount}"
                                               Icon="{ui:SymbolIcon Box24}"
                                               TargetPageType="{x:Type pages:MstAccountPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwProjectTemplate}"
                                               Icon="{ui:SymbolIcon BookTemplate20}"
                                               TargetPageType="{x:Type pages:ProjectTemplatePage}" />
                        
                    </ui:NavigationViewItem.MenuItems>
                    
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="NavTransaction"
                                       Content="{resx:Localization mwTransaction}"
                                       Icon="{ui:SymbolIcon Document24}"
                                       Click="NavTransaction_Click">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{resx:Localization mwItemAdjustment}"
                                               Icon="{ui:SymbolIcon BoxMultiple24}"
                                               TargetPageType="{x:Type pages:ItemAdjustmentPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwItemUsage}"
                                               Icon="{ui:SymbolIcon BoxMultiple24}"
                                               TargetPageType="{x:Type pages:ItemUsagePage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwPurchase}"
                                               Icon="{ui:SymbolIcon Cart24}"
                                               TargetPageType="{x:Type pages:PurchaseOrderPage}" />
                        
                        <ui:NavigationViewItem Content="{resx:Localization mwSales}"
                                               Icon="{ui:SymbolIcon Cart24}"
                                               TargetPageType="{x:Type pages:SalesOrderPage}" />
                        
                        <ui:NavigationViewItem Content="{resx:Localization mwProjectPurchaseOrder}"
                                               Icon="{ui:SymbolIcon DocumentQueue24}"
                                               TargetPageType="{x:Type pages:ProjectPurchaseOrderPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwProjectSalesOrder}"
                                               Icon="{ui:SymbolIcon DocumentQueue24}"
                                               TargetPageType="{x:Type pages:ProjectSalesOrderPage}" />

                        <ui:NavigationViewItem Content="{resx:Localization mwFinancial}"
                                               Icon="{ui:SymbolIcon Money24}"
                                               TargetPageType="{x:Type pages:FinancePage}" />
                        
                    </ui:NavigationViewItem.MenuItems>
                    
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{resx:Localization mwReport}"
                                       Icon="{ui:SymbolIcon ArrowTrendingLines24}">
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{resx:Localization mwSetting}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.Header>
                <Border Margin="10"
                        BorderBrush="{ui:ThemeResource ControlStrongFillColorDefaultBrush}"
                        BorderThickness="0,0,0,2"
                        HorizontalAlignment="Stretch"
                        CornerRadius="0">
                    <TextBlock Margin="24"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                               Text="NavigationView Header" />
                </Border>
            </ui:NavigationView.Header>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

        </ui:NavigationView>

        <ui:TitleBar x:Name="TitleBar"
                     Title="{resx:Localization ApplicationTitle}"
                     CloseWindowByDoubleClickOnIcon="True"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <!--<ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui.png" />
            </ui:TitleBar.Icon>-->
        </ui:TitleBar>

        <!--Icon="pack://application:,,,/Assets/wpfui.png"-->
        <tray:NotifyIcon FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="WPF UI Gallery">
            <tray:NotifyIcon.Menu>
                <ContextMenu DataContext="{Binding DataContext, Source={x:Reference NavigationView}}"
                             ItemsSource="{Binding VM.TrayMenuItems, Mode=OneWay}" />
            </tray:NotifyIcon.Menu>

        </tray:NotifyIcon>

        <ContentPresenter x:Name="RootContentDialog" />

    </Grid>

</ui:FluentWindow> 
